<?xml version="1.0"?>
<ruleset name="NiceIdeStandards">
    <description>Standards that also make sense</description>
    <rule ref="PSR12"/>

    <!-- Allow additional spaces after declarations -->
    <rule ref="PSR2.Classes.PropertyDeclaration.SpacingAfterType">
        <exclude name="PSR2.Classes.PropertyDeclaration.SpacingAfterType"/>
    </rule>

    <!-- Exclude the rule that enforces space after closing brace -->
    <rule ref="Squiz.ControlStructures.ControlSignature">
        <exclude name="Squiz.ControlStructures.ControlSignature.SpaceAfterCloseBrace"/>
    </rule>
</ruleset>
